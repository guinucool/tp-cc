; BIND reverse data file for empty rfc1918 zone
;
; DO NOT EDIT THIS FILE - it is used for multiple zones.
; Instead, copy it, edit named.conf, and use that copy.
;
$TTL	86400
@	IN	SOA	cc2324.local. 	root.cc2324.local. (
			      1		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			  86400 )	; Negative Cache TTL
;
	IN	A	10.4.4.1
@	IN	NS	localhost.
1.2.2	IN	PTR	PC1.cc2324.local.
2.2.2	IN 	PTR	PC2.cc2324.local.
1.1.1 	IN	PTR	Portatil1.cc2324.local.
2.1.1 	IN	PTR	Portatil2.cc2324.local.
1.4.4	IN	PTR	Servidor1.cc2324.local.
2.4.4 	IN	PTR	Servidor2.cc2324.local.
1.3.3	IN	PTR	Roma.cc2324.local.
2.3.3	IN	PTR	Paris.cc2324.local.
